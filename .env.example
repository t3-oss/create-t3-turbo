# Since .env is gitignored, you can use .env.example to build a new `.env` file when you clone the repo.
# Keep this file up-to-date when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any secrets in it.
# If you are cloning this repo, create a copy of this file named `.env` and populate it with your secrets.

# =====================================================
# REQUIRED: Database
# Choose ONE of these options for local development:
# =====================================================
#
# Option A: Docker Compose PostgreSQL (recommended for full-stack dev)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gmacko_dev"
#
# Option B: PGlite - embedded PostgreSQL, zero dependencies
# DATABASE_DRIVER=pglite
#
# Option C: Neon Serverless PostgreSQL (cloud)
DATABASE_URL="postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]_dev?sslmode=require"

# Staging database (for staging/beta builds) - used in CI/CD
# STAGING_DATABASE_URL="postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]_staging?sslmode=require"

# Production database - used in production deployments
# PRODUCTION_DATABASE_URL="postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require"

# Database driver override (auto-detected from DATABASE_URL if not set)
# DATABASE_DRIVER=  # Options: pglite, pg, (empty for Neon serverless)


# =====================================================
# REQUIRED: Authentication
# =====================================================
AUTH_SECRET='supersecret'

# Social Providers (auto-enabled when credentials are set)
AUTH_DISCORD_ID=''
AUTH_DISCORD_SECRET=''
# AUTH_GOOGLE_ID=''
# AUTH_GOOGLE_SECRET=''
# AUTH_GITHUB_ID=''
# AUTH_GITHUB_SECRET=''
# AUTH_MICROSOFT_ENTRA_ID_CLIENT_ID=''
# AUTH_MICROSOFT_ENTRA_ID_CLIENT_SECRET=''
# AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=''


# =====================================================
# OPTIONAL: Enterprise SSO / SAML 2.0
# Required only for enterprise customers using corporate IdP
# =====================================================
# SAML_ISSUER='https://yourapp.com'
# SAML_CALLBACK_URL='https://yourapp.com/api/auth/saml/callback'


# =====================================================
# OPTIONAL: Analytics (PostHog)
# Recommended: Use ONE PostHog project with environments
# OR separate projects per environment for isolation
# =====================================================

# --- Web (Next.js) ---
# PostHog automatically detects environment via VERCEL_ENV
# NEXT_PUBLIC_POSTHOG_KEY='phc_...'
# NEXT_PUBLIC_POSTHOG_HOST='https://us.i.posthog.com'

# --- Mobile (Expo) ---
# Environment-specific keys (if using separate projects)
# EXPO_PUBLIC_POSTHOG_KEY_DEV='phc_dev_...'
# EXPO_PUBLIC_POSTHOG_KEY_STAGING='phc_staging_...'
# EXPO_PUBLIC_POSTHOG_KEY_PROD='phc_prod_...'
# EXPO_PUBLIC_POSTHOG_HOST='https://us.i.posthog.com'

# Or use single project (recommended - use PostHog environments)
# EXPO_PUBLIC_POSTHOG_KEY='phc_...'


# =====================================================
# OPTIONAL: Monitoring (Sentry)
# IMPORTANT: Create separate Sentry projects for web vs mobile
# Each can use environments (development/staging/production)
# =====================================================

# --- Web (Next.js) ---
# Sentry automatically detects environment via VERCEL_ENV
# Create project: yourorg/yourapp-web
# NEXT_PUBLIC_SENTRY_DSN='https://...@sentry.io/...'

# Build-time for source maps (shared across environments)
# SENTRY_AUTH_TOKEN=''
# SENTRY_ORG='your-org'
# SENTRY_PROJECT_WEB='yourapp-web'

# --- Mobile (Expo) ---
# Create project: yourorg/yourapp-mobile
# Environment-specific DSNs (if using separate projects)
# EXPO_PUBLIC_SENTRY_DSN_DEV='https://...@sentry.io/...'
# EXPO_PUBLIC_SENTRY_DSN_STAGING='https://...@sentry.io/...'
# EXPO_PUBLIC_SENTRY_DSN_PROD='https://...@sentry.io/...'

# Or use single project (recommended - use Sentry environments)
# EXPO_PUBLIC_SENTRY_DSN='https://...@sentry.io/...'

# Build-time for mobile source maps
# SENTRY_PROJECT_MOBILE='yourapp-mobile'


# =====================================================
# OPTIONAL: API URLs (Mobile)
# Used by EAS builds for environment-specific API endpoints
# =====================================================
# STAGING_API_URL='https://staging-api.yourapp.com'
# PRODUCTION_API_URL='https://api.yourapp.com'


# =====================================================
# OPTIONAL: Payments - Web (Stripe)
# =====================================================
# STRIPE_SECRET_KEY=''
# STRIPE_WEBHOOK_SECRET='whsec_...'
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=''


# =====================================================
# OPTIONAL: Payments - Mobile (RevenueCat)
# Configured in app.config.ts extra.revenuecatApiKey
# =====================================================
# See: https://www.revenuecat.com/docs/getting-started


# =====================================================
# OPTIONAL: Push Notifications (Expo)
# Configured in app.config.ts with EAS project ID
# =====================================================
# See: https://docs.expo.dev/push-notifications/overview/


# =====================================================
# OPTIONAL: Email (Resend)
# =====================================================
# RESEND_API_KEY=''


# =====================================================
# OPTIONAL: Realtime (Pusher)
# =====================================================
# PUSHER_APP_ID=''
# PUSHER_KEY=''
# PUSHER_SECRET=''
# PUSHER_CLUSTER=''
# NEXT_PUBLIC_PUSHER_KEY=''
# NEXT_PUBLIC_PUSHER_CLUSTER=''


# =====================================================
# OPTIONAL: Storage (UploadThing)
# =====================================================
# UPLOADTHING_TOKEN=''


# =====================================================
# OPTIONAL: MCP Server (AI Integration)
# Used by create-gmacko-app-mcp CLI tool
# Stripe tools are enabled when STRIPE_SECRET_KEY is set
# =====================================================
# GMACKO_API_URL='http://localhost:3000'
# GMACKO_API_KEY='gmk_...'


# =====================================================
# OPTIONAL: LLM API Keys (for CLI landing page generation)
# Only needed during `npx create-gmacko-app` scaffolding
# =====================================================
# ANTHROPIC_API_KEY='sk-ant-...'    # For Claude
# OPENAI_API_KEY='sk-...'           # For Codex/GPT
# GOOGLE_API_KEY='AI...'            # For Gemini


# =====================================================
# OPTIONAL: CI/CD - Container Registry
# Configure which registry to push Docker images to
# =====================================================
# DOCKER_REGISTRY='ghcr'  # Options: ghcr, dockerhub, harbor

# Docker Hub (if using dockerhub)
# DOCKERHUB_USERNAME='your-username'
# DOCKERHUB_TOKEN='dckr_pat_...'

# Harbor (if using harbor)
# HARBOR_REGISTRY_URL='harbor.your-company.com'
# HARBOR_USERNAME='robot$your-robot'
# HARBOR_PASSWORD='secret'
# HARBOR_PROJECT='your-project'


# =====================================================
# OPTIONAL: CI/CD - Package Publishing
# Configure npm registry for publishing packages
# =====================================================
# NPM_REGISTRY_URL='https://registry.npmjs.org'
# NPM_TOKEN='npm_...'

# For private registries (Verdaccio, GitHub Packages, etc.)
# NPM_REGISTRY_URL='https://npm.your-company.com'
# NPM_TOKEN='your-registry-token'


# =====================================================
# OPTIONAL: CI/CD - SDK Publishing
# Configure where to publish generated SDKs
# =====================================================
# PUBLISH_PYPI='true'
# PYPI_TOKEN='pypi-...'

# PUBLISH_GO='true'  # Tags Go SDK for go get


# =====================================================
# OPTIONAL: Background Jobs / Cron
# =====================================================
# CRON_SECRET='your-cron-secret'  # Protects /api/cron/* endpoints

# =====================================================
# OPTIONAL: App Configuration
# =====================================================
# APP_NAME='Your App Name'
# NEXT_PUBLIC_APP_URL='http://localhost:3000'
