# Shared config for the monorepo. Each app's own .env.schema imports this file
# with an explicit pick list. Local overrides go in gitignored .env / .env.local;
# encrypt sensitive .env.local values with `pnpm exec varlock encrypt --file .env.local`.
# @defaultSensitive=false
# @defaultRequired=infer
# ---
# SQLite database path. Supplied at boot in Docker (/data/sqlite.db).
# @type=string @sensitive=false @dynamic=boot
DATABASE_URL=./sqlite.db
# Public URL of the Elysia server (better-auth base URL).
# @type=url @sensitive=false
BETTER_AUTH_URL=http://localhost:3000
# Port the Elysia server listens on.
# @type=number @sensitive=false
PORT=3000
# Base URL the web app (port 3001) uses to reach the API server for Eden Treaty
# and the better-auth client.
# @type=url @sensitive=false
VITE_API_URL=http://localhost:3000
# better-auth secret. Dev placeholder — override with a real value in .env.local.
# @type=string @sensitive
AUTH_SECRET=local-dev-placeholder-not-for-prod
# Discord OAuth client id (public identifier); empty until Discord login is configured.
# @type=string @sensitive=false
AUTH_DISCORD_ID=''
# Discord OAuth client secret; set in .env.local (encrypted) to enable Discord login.
# @type=string @sensitive @optional
AUTH_DISCORD_SECRET=
